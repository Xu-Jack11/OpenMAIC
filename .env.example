VIDEO_GROK_BASE_URL=

# --- Web Search ---------------------------------------------------------------
# Note: Grok (xAI) web search is available via chat completions + search tools,
# not as a standalone search API. Use Grok LLM provider with search_parameters
# in chat requests. See: https://docs.x.ai/docs/guides/tools/search-tools

TAVILY_API_KEY=

# --- RAGFlow (Document RAG) ---------------------------------------------------
# RAGFlow provides document parsing, chunking, embedding, and hybrid retrieval.
# Deploy RAGFlow separately: https://github.com/infiniflow/ragflow
RAGFLOW_BASE_URL=http://ragflow:9380/api/v1
RAGFLOW_API_KEY=

# Optional RAGFlow tuning
# RAGFLOW_CHUNK_METHOD=naive              # naive|book|paper|laws|manual|presentation|qa|table
# RAGFLOW_SIMILARITY_THRESHOLD=0.3        # Hybrid score threshold (0-1)
# RAGFLOW_VECTOR_SIMILARITY_WEIGHT=0.3    # Weight for vector vs keyword (0-1)
# RAGFLOW_PARSE_TIMEOUT_MS=300000         # Max wait for parsing (5 min)
# RAGFLOW_PARTIAL_SUCCESS_MIN_PROGRESS=0.7  # Accept run=FAIL as indexed when progress ≥ this (0-1).
                                            # Set to 1.0 to require full success. Motivated by the
                                            # naive parser occasionally failing late while most
                                            # chunks are already usable.

# Retrieval configuration
# RAG_TOP_K=5                 # Number of chunks to retrieve
# RAG_SIMILARITY_THRESHOLD=0.3  # Minimum similarity score (0-1, hybrid)
# RAG_MAX_CONTEXT_TOKENS=2000   # Max tokens for document context in prompts

# --- Proxy (optional) --------------------------------------------------------

# HTTP_PROXY=
# HTTPS_PROXY=

# --- Misc ---------------------------------------------------------------------

# Optional server-side default model for API routes like /api/generate-classroom
# Example: anthropic:claude-3-5-haiku-20241022 or google:gemini-3-flash-preview
# MiniMax example: minimax:MiniMax-M2.7-highspeed
DEFAULT_MODEL=

# LOG_LEVEL=info
# LOG_FORMAT=pretty
# LLM_THINKING_DISABLED=false
